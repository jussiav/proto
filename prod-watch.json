        "resources/assets/js/tenderRequestDraftForm/steps/components/RetrievedVehicleInfo*.vue",
        "resources/assets/js/tenderRequestDraftForm/components/VehicleMetrics.vue",
        "app/Http/Controllers/Api/TenderRequestDraft/RetrieveVehicleInformation.php",
        "resources/lang/fi/metrics.php"
      ]
    },
    {
      "id": "Service step (services.html)",
      "kind": "page",
      "proto": [

{
  "project": "c2b-proto (Claude-Figma)",
  "about": "Which production files each proto page, shared script, initiative and spec transcribes. Read by ../prod/bin/prod-update.mjs to sort every prod change by what it affects here. Paths are globs relative to the prod repo root. Add an entry when a page or initiative starts depending on a prod file; never put report content or PR titles in this file (the repo is mirrored publicly).",
  "entries": [
    {
      "id": "Front page and hero form",
      "kind": "page",
      "proto": [
        "index.html",
        "hero-theme.js"
      ],
      "paths": [
        "resources/astro/pages/index.astro",
        "resources/astro/components/**",
        "resources/astro/layouts/**",
        "resources/assets/js/tenderRequestDraftForm/LandingPageForm*.vue"
      ]
    },
    {
      "id": "Funnel: shared shell, state machine, fields",
      "kind": "page",
      "proto": [
        "details.html",
        "services.html",
        "photos.html",
        "price.html",
        "contact.html",
        "success.html",
        "funnel-guard.js",
        "proto-mock.js"
      ],
      "paths": [
        "resources/assets/js/tenderRequestDraftForm/*.{vue,js,ts}",
        "resources/assets/js/tenderRequestDraftForm/useTenderFormMachine/**",
        "resources/assets/js/tenderRequestDraftForm/components/*.vue",
        "resources/assets/js/tenderRequestDraftForm/fields/**",

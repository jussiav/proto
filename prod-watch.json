        "app/Http/Resources/TenderRequestDraftResource.php",
        "app/Actions/TenderRequestDraft/UpdateDraft.php"
      ],
      "exclude": [
        "resources/assets/js/tenderRequestDraftForm/LandingPageForm*.vue"
      ]
    },
    {
